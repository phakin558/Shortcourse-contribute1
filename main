public class main {
    public static void main(String[] args) {
        // Simple Calculator
        // Feature files will be added from separate branches.

        int firstNumber = 10;
        int secondNumber = 5;

        System.out.println("=== Simple Calculator ===");
        System.out.println("1. Addition");
        System.out.println("2. Multiplication");
        System.out.println();

        // These feature classes do not exist yet in the starter version.
        // After ProgrammerA and ProgrammerB are merged, this file will work.
        System.out.println("Addition: " +
                ProgrammerA.addition.add(firstNumber, secondNumber));

        System.out.println("Multiplication: " +
                ProgrammerB.multiplication.multiply(firstNumber, secondNumber));
    }
}
